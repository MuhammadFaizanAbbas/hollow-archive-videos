  "sources": ["Original fiction (SCIFI world-rule). Real-science nod: sound can shake loose sand (singing dunes). Fiction, never presented as true."],
  "lines": [
    { "text": "Don't. Whistle. Tonight.", "caps": "Don't. | Whistle. | Tonight.", "gap": 0.2 },
    { "text": "On this planet, whistling after dark is illegal." },
    { "text": "Even the birds just hum." },
    { "text": "I'm Zed. I just landed," },
    { "text": "and nobody would tell me why." },
    { "text": "So I whistled." },
    { "text": "One tiny tune, behind the barn." },
    { "text": "But the ground started to wobble." },
    { "text": "A farmer ran out in his pajamas." },
    { "text": "Stop! Put your lips away!" },
    { "text": "Too late." },
    { "text": "The hills stood up." },
    { "text": "Hills with legs!" },
    { "text": "Ten sand giants, dancing down Main Street." },
    { "text": "One bowed to the mayor." },
    { "text": "The mayor bowed back." },
    { "text": "Very polite. Very huge.", "gap": 0.2 },
    { "text": "Ha ha ha!", "gap": 0.15 },
    { "text": "So I panicked, and whistled louder." },
    { "text": "Now they spin!", "gap": 0.35 },
    { "text": "Then a farmer explained." },
    { "text": "Giants sleep under the sand." },
    { "text": "Whistle in the fields," },
    { "text": "and they plough them for free." },
    { "text": "But whistle in town," },
    { "text": "and they flatten the bakery." },
    { "text": "Now I'm banned from the bakery." },
    { "text": "Don't. Whistle. Tonight.", "caps": "Don't. | Whistle. | Tonight." }
  ]
}
